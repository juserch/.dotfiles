<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.juserch.jserver-vm</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/.local/bin/jserver-vm</string>
    <string>start</string>
  </array>
  <!-- 登录时跑一次；VM 已在运行则脚本自身幂等退出 -->
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <false/>
  <key>ProcessType</key>        <string>Background</string>
  <!-- 脚本退出后留下 caffeinate（睡眠断言）；不加则 launchd 连同进程组一起杀（2026-11-01 实测） -->
  <key>AbandonProcessGroup</key> <true/>
  <key>StandardOutPath</key>    <string>$HOME/Library/Logs/jserver-vm.log</string>
  <key>StandardErrorPath</key>  <string>$HOME/Library/Logs/jserver-vm.log</string>
</dict>
</plist>
