#!/bin/sh
# veltora-slot-protocol: 1
# Non-compiling commands run directly; every heavy command uses the canonical queue.
[ "${1:-}" = --veltora-slot-protocol ] && { echo 1; exit 0; }
REAL=${VM_BUILD_REAL:-"$HOME/.cargo/bin/cargo"}
: "${CARGO_BUILD_JOBS:=2}"; export CARGO_BUILD_JOBS
_mark_acquired() {
    [ -n "${CARGO_SLOT_ACQUIRED_FILE:-}" ] && ( set -C; printf '%s\n' "$(date +%s)" > "$CARGO_SLOT_ACQUIRED_FILE" ) 2>/dev/null
    return 0
}
_sub=${1:-}; case "$_sub" in +*) _sub=${2:-} ;; esac
case "$_sub" in
    metadata|tree|locate-project|pkgid|read-manifest|verify-project|version|help|-V|--version|-h|--help)
        _mark_acquired; exec "$REAL" "$@" ;;
    deny)
        case "${1:-}" in +*) shift ;; esac
        CARGO=$REAL; export CARGO
        _mark_acquired; exec "${REAL%/cargo}/cargo-deny" "$@" ;;
    fmt|clean|update|fetch|generate-lockfile|add|remove|search|login|logout|owner|yank|config|info|report|init|new)
        _mark_acquired; exec "$REAL" "$@" ;;
esac
# A caller-set VM_BUILD_SLICE is never proof of an inherited lease. Only the
# canonical helper validates its locked descriptor, nonce and kernel scope.
_ADMISSION=${VM_BUILD_ADMISSION:-"$(dirname -- "$0")/veltora-admission"}
exec "$_ADMISSION" run --class P2 -- "$REAL" "$@"
