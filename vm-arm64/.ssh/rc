# ~/.ssh/rc —— sshd 在每个 SSH 会话开始、执行用户命令之前用 /bin/sh 运行它
# ⚠️ 它的 stdout 直通会话：任何输出都会混进 git / rsync / VS Code 的协议流，必须全部重定向
# ⚠️ 本文件存在时 sshd 不再自动跑 xauth（本机不用 X11 转发，无影响）
# 用途：连上来那一刻先让 VS Code server 自愈（见 ~/.local/bin/vscode-server-selfheal 文件头）
if [ -x "$HOME/.local/bin/vscode-server-selfheal" ]; then
    VSCODE_SELFHEAL_SOURCE=ssh-rc timeout 10 "$HOME/.local/bin/vscode-server-selfheal" </dev/null >/dev/null 2>&1
fi
exit 0
